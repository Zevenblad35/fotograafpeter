---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../config';

const title = 'Cookiebeleid | Fotograaf Peter';
const description = 'Cookiebeleid van Fotograaf Peter — welke cookies ik gebruik en waarom.';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Cookiebeleid', href: '/cookiebeleid/' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/cookiebeleid/"
  breadcrumbs={breadcrumbs}
>
  <PageHeader
    eyebrow="Juridisch"
    title="Cookiebeleid"
    description="Welke cookies deze website gebruikt en waarom. Laatst bijgewerkt op 1 januari 2026."
    breadcrumbs={breadcrumbs}
  />

  <article class="legal-section">
    <div class="container-prose legal-prose">
      <h2>Wat zijn cookies?</h2>
      <p>
        Cookies zijn kleine tekstbestanden die door je browser worden opgeslagen
        wanneer je een website bezoekt. Ze helpen websites te onthouden wie je
        bent en hoe je de site gebruikt.
      </p>

      <h2>Welke cookies gebruik ik?</h2>
      <p>
        Deze website is bewust minimaal opgezet en gebruikt zo min mogelijk
        cookies. Concreet:
      </p>

      <h3>Functionele cookies (altijd actief)</h3>
      <p>
        Strikt noodzakelijk voor de werking van de site — bijvoorbeeld om
        formulierinvoer te onthouden tijdens je bezoek. Hier hoef je geen
        toestemming voor te geven.
      </p>

      <h3>Statistische cookies (optioneel)</h3>
      <p>
        Als ik analytics inzet, kies ik voor een privacyvriendelijke tool die
        IP-adressen anonimiseert en geen persoonlijke profielen aanmaakt. Hiervoor
        is — afhankelijk van de gekozen tool — geen toestemming nodig. Mocht ik
        Google Analytics inzetten, dan zal er een cookiebanner verschijnen.
      </p>

      <h3>Marketing-cookies</h3>
      <p>
        Deze website gebruikt geen marketing- of trackingcookies van derden.
      </p>

      <h2>Cookies verwijderen of weigeren</h2>
      <p>
        Je kunt cookies altijd verwijderen of weigeren via de instellingen van
        je browser. Dat kan invloed hebben op de werking van sommige onderdelen
        van de website.
      </p>
      <ul>
        <li>Chrome: Instellingen → Privacy en beveiliging → Cookies</li>
        <li>Firefox: Instellingen → Privacy en beveiliging</li>
        <li>Safari: Voorkeuren → Privacy</li>
        <li>Edge: Instellingen → Cookies en sitemachtigingen</li>
      </ul>

      <h2>Vragen?</h2>
      <p>
        Mail naar <a href={`mailto:${SITE.contact.email}`} class="link-inline">{SITE.contact.email}</a>.
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .legal-section { padding-block: clamp(2.5rem, 5vw, 4.5rem); }
  .legal-prose h2 {
    font-size: 1.4rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .legal-prose h2:first-child { margin-top: 0; }
  .legal-prose h3 {
    font-size: 1.1rem;
    margin-top: 1.5rem;
    margin-bottom: 0.6rem;
  }
  .legal-prose p, .legal-prose ul {
    color: var(--color-ink-soft);
    margin-bottom: 1rem;
    line-height: 1.7;
  }
  .legal-prose ul { padding-left: 1.25rem; }
  .legal-prose li { margin-bottom: 0.4rem; }
</style>
