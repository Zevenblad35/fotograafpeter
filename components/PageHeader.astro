---
export interface Crumb { name: string; href: string; }

export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  breadcrumbs?: Crumb[];
  /** Pad naar achtergrondfoto, bv. '/images/headers/bedrijfsfotografie.jpg' */
  image?: string;
  /** Alt-tekst voor screen readers */
  imageAlt?: string;
}

const {
  eyebrow,
  title,
  description,
  breadcrumbs,
  image,
  imageAlt = '',
} = Astro.props;
---

<section class="page-header" data-has-image={image ? 'true' : 'false'}>
  {image && (
    <div class="ph-image" role="img" aria-label={imageAlt}>
      <img src={image} alt={imageAlt} loading="eager" fetchpriority="high" />
      <div class="ph-image-overlay"></div>
    </div>
  )}

  <div class="container ph-inner">
    {breadcrumbs && breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol>
          {breadcrumbs.map((b, i) => (
            <li>
              {i < breadcrumbs.length - 1
                ? <><a href={b.href}>{b.name}</a><span class="sep">/</span></>
                : <span aria-current="page">{b.name}</span>
              }
            </li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <span class="eyebrow reveal">{eyebrow}</span>}
    <h1 class="page-title reveal reveal-delay-1">{title}</h1>
    {description && <p class="page-desc reveal reveal-delay-2">{description}</p>}
  </div>
</section>

<style>
  .page-header {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--color-line);
  }

  /* Met foto: groter, meer ademruimte */
  .page-header[data-has-image='true'] {
    min-height: clamp(420px, 55vh, 580px);
    padding-block: clamp(5rem, 8vw, 7rem) clamp(3rem, 5vw, 4rem);
    display: flex;
    align-items: center;
    border-bottom: none;
  }

  .ph-image {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .ph-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  .ph-image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg,
      rgba(26, 24, 20, 0.82) 0%,
      rgba(26, 24, 20, 0.6) 45%,
      rgba(26, 24, 20, 0.3) 80%,
      rgba(26, 24, 20, 0.4) 100%);
  }

  .ph-inner {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  /* Breadcrumb styling */
  .breadcrumb ol {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.82rem;
    color: var(--color-ink-muted);
    margin-bottom: 1.75rem;
    letter-spacing: 0.02em;
  }
  .breadcrumb a {
    color: var(--color-ink-muted);
    transition: color var(--t);
  }
  .breadcrumb a:hover { color: var(--color-accent); }
  .breadcrumb .sep { margin-left: 0.6rem; opacity: 0.5; }
  .breadcrumb [aria-current] { color: var(--color-ink); }

  /* Met foto: lichte breadcrumb */
  .page-header[data-has-image='true'] .breadcrumb ol {
    color: rgba(255, 255, 255, 0.65);
  }
  .page-header[data-has-image='true'] .breadcrumb a {
    color: rgba(255, 255, 255, 0.65);
  }
  .page-header[data-has-image='true'] .breadcrumb a:hover {
    color: var(--color-highlight);
  }
  .page-header[data-has-image='true'] .breadcrumb [aria-current] {
    color: var(--color-bg);
  }

  /* Eyebrow op donkere bg */
  .page-header[data-has-image='true'] :global(.eyebrow) {
    color: var(--color-highlight);
  }
  .page-header[data-has-image='true'] :global(.eyebrow::before) {
    background: var(--color-highlight);
  }

  .page-title {
    margin-top: 1rem;
    font-size: clamp(2.5rem, 6vw + 0.5rem, 5rem);
    line-height: 1;
    font-weight: 250;
    max-width: 18ch;
    letter-spacing: -0.035em;
  }

  .page-header[data-has-image='true'] .page-title {
    color: var(--color-bg);
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.3);
  }

  .page-desc {
    margin-top: 1.5rem;
    max-width: 60ch;
    font-size: clamp(1.05rem, 1vw + 0.85rem, 1.2rem);
    color: var(--color-ink-soft);
    line-height: 1.55;
  }

  .page-header[data-has-image='true'] .page-desc {
    color: rgba(255, 255, 255, 0.88);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.3);
  }
</style>
