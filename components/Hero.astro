---
export interface Props {
  eyebrow?: string;
  title: string;
  titleEm?: string;
  description?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
  /** Pad naar achtergrond afbeelding, bv. '/images/headers/home.jpg' */
  image?: string;
  /** Alt-tekst voor screen readers */
  imageAlt?: string;
}

const {
  eyebrow,
  title,
  titleEm,
  description,
  primaryCta,
  secondaryCta,
  image,
  imageAlt = '',
} = Astro.props;
---

<section class="hero" data-has-image={image ? 'true' : 'false'}>
  {image && (
    <div class="hero-image" role="img" aria-label={imageAlt}>
      <img src={image} alt={imageAlt} loading="eager" fetchpriority="high" />
      <div class="hero-image-overlay"></div>
    </div>
  )}

  <div class="container hero-inner">
    {eyebrow && <span class="eyebrow reveal">{eyebrow}</span>}

    <h1 class="hero-title reveal reveal-delay-1">
      {title}
      {titleEm && <><br /><em>{titleEm}</em></>}
    </h1>

    {description && <p class="hero-desc reveal reveal-delay-2">{description}</p>}

    {(primaryCta || secondaryCta) && (
      <div class="hero-ctas reveal reveal-delay-3">
        {primaryCta && (
          <a href={primaryCta.href} class="btn btn-primary">
            {primaryCta.label}
            <span class="arrow">→</span>
          </a>
        )}
        {secondaryCta && (
          <a href={secondaryCta.href} class="btn btn-secondary">{secondaryCta.label}</a>
        )}
      </div>
    )}

    <div class="hero-mark reveal reveal-delay-4">
      <span class="hero-mark-num">№ 01</span>
      <span class="hero-mark-line"></span>
      <span class="hero-mark-text">Nijverdal · Twente · Overijssel</span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: clamp(560px, 75vh, 820px);
    display: flex;
    align-items: center;
    padding-block: clamp(4rem, 8vw, 7rem);
    overflow: hidden;
    color: var(--color-ink);
  }

  /* Achtergrondfoto */
  .hero-image {
    position: absolute;
    inset: 0;
    z-index: 0;
  }
  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Donkere overlay voor tekst-leesbaarheid */
  .hero-image-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(105deg,
        rgba(26, 24, 20, 0.78) 0%,
        rgba(26, 24, 20, 0.55) 40%,
        rgba(26, 24, 20, 0.25) 70%,
        rgba(26, 24, 20, 0.35) 100%);
  }

  /* Als er een foto is: zet alle tekst in lichte tint */
  .hero[data-has-image='true'] {
    color: var(--color-bg);
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1100px;
    width: 100%;
  }

  /* Eyebrow op donkere bg */
  .hero[data-has-image='true'] :global(.eyebrow) {
    color: var(--color-highlight);
  }
  .hero[data-has-image='true'] :global(.eyebrow::before) {
    background: var(--color-highlight);
  }

  .hero-title {
    margin-top: 1.5rem;
    font-size: clamp(2.75rem, 8vw + 0.5rem, 7rem);
    line-height: 0.98;
    font-weight: 250;
    letter-spacing: -0.04em;
    max-width: 14ch;
  }

  .hero[data-has-image='true'] .hero-title {
    color: var(--color-bg);
    text-shadow: 0 2px 30px rgba(0, 0, 0, 0.3);
  }

  .hero-title em {
    font-style: italic;
    font-weight: 250;
    color: var(--color-accent);
    font-feature-settings: 'ss01' 1;
  }

  .hero[data-has-image='true'] .hero-title em {
    color: var(--color-highlight);
  }

  .hero-desc {
    margin-top: 1.75rem;
    max-width: 50ch;
    font-size: clamp(1.05rem, 1vw + 0.85rem, 1.25rem);
    line-height: 1.55;
    color: var(--color-ink-soft);
  }

  .hero[data-has-image='true'] .hero-desc {
    color: rgba(255, 255, 255, 0.88);
    text-shadow: 0 1px 12px rgba(0, 0, 0, 0.3);
  }

  .hero-ctas {
    margin-top: 2.5rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  /* Buttons op donkere bg krijgen een andere stijl */
  .hero[data-has-image='true'] :global(.btn-primary) {
    background: var(--color-bg);
    color: var(--color-ink);
  }
  .hero[data-has-image='true'] :global(.btn-primary:hover) {
    background: var(--color-highlight);
    color: var(--color-ink);
  }
  .hero[data-has-image='true'] :global(.btn-secondary) {
    background: transparent;
    color: var(--color-bg);
    border-color: var(--color-bg);
  }
  .hero[data-has-image='true'] :global(.btn-secondary:hover) {
    background: var(--color-bg);
    color: var(--color-ink);
  }

  .hero-mark {
    margin-top: 3.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .hero[data-has-image='true'] .hero-mark {
    color: rgba(255, 255, 255, 0.65);
  }

  .hero-mark-num {
    font-family: var(--font-display);
    font-size: 0.85rem;
    color: var(--color-accent);
    letter-spacing: 0;
  }
  .hero[data-has-image='true'] .hero-mark-num {
    color: var(--color-highlight);
  }

  .hero-mark-line {
    flex: 1;
    max-width: 80px;
    height: 1px;
    background: var(--color-line);
  }
  .hero[data-has-image='true'] .hero-mark-line {
    background: rgba(255, 255, 255, 0.3);
  }

  /* Zonder foto: subtiele radial gradient als fallback (oude gedrag) */
  .hero[data-has-image='false']::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 30%, rgba(139, 90, 43, 0.06) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(200, 155, 106, 0.05) 0%, transparent 50%);
    pointer-events: none;
  }
</style>
