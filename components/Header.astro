---
import { MAIN_MENU, SITE } from '../config';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Naar de homepagina">
      <span class="brand-mark">FP</span>
      <span class="brand-text">
        <span class="brand-name">Fotograaf Peter</span>
        <span class="brand-tag">{SITE.contact.address.city} · Twente</span>
      </span>
    </a>

    <nav class="primary-nav" aria-label="Hoofdnavigatie">
      <ul>
        {MAIN_MENU.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-link', { 'is-active': isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="/contact/" class="header-cta">
      <span>Plan shoot</span>
      <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 7h8M7.5 3.5L11 7l-3.5 3.5" />
      </svg>
    </a>

    <button class="menu-toggle" aria-label="Menu openen" aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobiel menu -->
  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav aria-label="Mobiel menu">
      <ul>
        {MAIN_MENU.map((item) => (
          <li>
            <a href={item.href} class:list={['mobile-nav-link', { 'is-active': isActive(item.href) }]}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="mobile-contact">
        <a href={`tel:${SITE.contact.phone}`} class="link-inline">{SITE.contact.phoneDisplay}</a>
        <a href={`mailto:${SITE.contact.email}`} class="link-inline">{SITE.contact.email}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-line);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-block: 1rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-shrink: 0;
  }

  .brand-mark {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    background: var(--color-ink);
    color: var(--color-bg);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.1rem;
    letter-spacing: -0.04em;
    border-radius: 50%;
    transition: transform var(--t);
  }

  .brand:hover .brand-mark { transform: rotate(-12deg); }

  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .brand-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 400;
    letter-spacing: -0.015em;
  }

  .brand-tag {
    font-size: 0.7rem;
    color: var(--color-ink-muted);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: 1px;
  }

  .primary-nav {
    flex: 1;
    display: flex;
    justify-content: center;
  }

  .primary-nav ul {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 0.4rem;
  }

  .nav-link {
    display: inline-block;
    padding: 0.5rem 0.9rem;
    font-size: 0.92rem;
    color: var(--color-ink-soft);
    position: relative;
    transition: color var(--t);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.25rem;
    height: 1px;
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t);
  }

  .nav-link:hover { color: var(--color-ink); }
  .nav-link:hover::after,
  .nav-link.is-active::after { transform: scaleX(1); }
  .nav-link.is-active { color: var(--color-ink); }

  .header-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    background: var(--color-ink);
    color: var(--color-bg);
    border-radius: 999px;
    font-size: 0.88rem;
    transition: all var(--t);
    flex-shrink: 0;
  }
  .header-cta:hover {
    background: var(--color-accent-deep);
    transform: translateY(-1px);
  }
  .header-cta svg { transition: transform var(--t); }
  .header-cta:hover svg { transform: translateX(3px); }

  .menu-toggle {
    display: none;
    width: 40px;
    height: 40px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
  }
  .menu-toggle span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--color-ink);
    transition: transform var(--t), opacity var(--t);
  }
  .menu-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .menu-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
  .menu-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  .mobile-menu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
    padding: 1.5rem clamp(1.25rem, 4vw, 3rem) 2rem;
    animation: slideDown 0.3s ease-out;
  }
  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .mobile-menu ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .mobile-nav-link {
    display: block;
    padding: 0.9rem 0;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 350;
    letter-spacing: -0.02em;
    border-bottom: 1px solid var(--color-line);
  }
  .mobile-nav-link.is-active { color: var(--color-accent); }

  .mobile-contact {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 1.5rem;
    font-size: 0.95rem;
    color: var(--color-ink-muted);
  }

  @media (max-width: 960px) {
    .primary-nav { display: none; }
    .header-cta { display: none; }
    .menu-toggle { display: flex; }
  }

  @media (max-width: 460px) {
    .brand-tag { display: none; }
  }
</style>

<script>
  const toggle = document.querySelector('.menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isOpen = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isOpen));
      toggle.setAttribute('aria-label', isOpen ? 'Menu openen' : 'Menu sluiten');
      if (isOpen) menu.setAttribute('hidden', '');
      else menu.removeAttribute('hidden');
    });
  }
</script>
