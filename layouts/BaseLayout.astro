---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config';

export interface Props {
  title: string;
  description: string;
  /** Canonical pad relatief aan de site, bv. '/contact/' */
  canonicalPath?: string;
  /** OG/Twitter image, absoluut of relatief */
  image?: string;
  /** Type pagina voor structured data */
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'Service';
  /** Eventuele extra JSON-LD entities */
  extraJsonLd?: object[];
  /** Breadcrumbs */
  breadcrumbs?: { name: string; href: string }[];
  /** noindex aanzetten? */
  noindex?: boolean;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  image = '/og-default.jpg',
  pageType = 'WebPage',
  extraJsonLd = [],
  breadcrumbs,
  noindex = false,
} = Astro.props;

const canonical = new URL(canonicalPath, SITE.url).toString();
const ogImage = image.startsWith('http') ? image : new URL(image, SITE.url).toString();
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;

// LocalBusiness — kern van lokale SEO
const localBusinessLd = {
  '@context': 'https://schema.org',
  '@type': ['LocalBusiness', 'ProfessionalService', 'Photograph'],
  '@id': `${SITE.url}/#business`,
  name: SITE.name,
  legalName: SITE.business.legalName,
  url: SITE.url,
  email: SITE.contact.email,
  telephone: SITE.contact.phone,
  image: ogImage,
  logo: new URL('/logo.svg', SITE.url).toString(),
  description: SITE.description,
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.contact.address.street,
    postalCode: SITE.contact.address.postalCode,
    addressLocality: SITE.contact.address.city,
    addressRegion: SITE.contact.address.region,
    addressCountry: SITE.contact.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 52.3611,
    longitude: 6.4675,
  },
  areaServed: SITE.serviceArea.map((a) => ({ '@type': 'City', name: a })),
  openingHoursSpecification: SITE.openingHours
    .filter((d) => d.isOpen)
    .map((d) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: d.day === 'Maandag' ? 'Monday'
        : d.day === 'Dinsdag' ? 'Tuesday'
        : d.day === 'Woensdag' ? 'Wednesday'
        : d.day === 'Donderdag' ? 'Thursday'
        : d.day === 'Vrijdag' ? 'Friday'
        : d.day === 'Zaterdag' ? 'Saturday' : 'Sunday',
      opens: d.open,
      closes: d.close,
    })),
  founder: { '@type': 'Person', name: SITE.business.owner },
  knowsAbout: [
    'Bedrijfsfotografie',
    'Personal branding fotografie',
    'Reclamefotografie',
    'Productfotografie',
    'Food fotografie',
    'Interieurfotografie',
    'Vastgoedfotografie',
    'Evenementenfotografie',
    'Zakelijke portretten',
    'Sportfotografie',
  ],
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.name,
  description: SITE.description,
  inLanguage: SITE.locale,
  publisher: { '@id': `${SITE.url}/#business` },
};

const webpageLd = {
  '@context': 'https://schema.org',
  '@type': pageType,
  '@id': `${canonical}#webpage`,
  url: canonical,
  name: title,
  description,
  inLanguage: SITE.locale,
  isPartOf: { '@id': `${SITE.url}/#website` },
  about: { '@id': `${SITE.url}/#business` },
  primaryImageOfPage: ogImage,
};

const breadcrumbLd = breadcrumbs && breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((b, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: b.name,
    item: new URL(b.href, SITE.url).toString(),
  })),
} : null;

const allJsonLd = [localBusinessLd, websiteLd, webpageLd, breadcrumbLd, ...extraJsonLd].filter(Boolean);
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary meta -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {!noindex && <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}

    <!-- Hreflang -->
    <link rel="alternate" hreflang="nl-NL" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <!-- Geo tags (lokale SEO) -->
    <meta name="geo.region" content="NL-OV" />
    <meta name="geo.placename" content="Nijverdal" />
    <meta name="geo.position" content="52.3611;6.4675" />
    <meta name="ICBM" content="52.3611, 6.4675" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="nl_NL" />
    <meta property="og:site_name" content={SITE.name} />

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Auteur & taal -->
    <meta name="author" content={SITE.business.owner} />
    <meta name="language" content="Dutch" />

    <!-- Theme color -->
    <meta name="theme-color" content="#1a1814" />
    <meta name="color-scheme" content="light" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Preconnect voor fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,200..700;1,9..144,200..700&family=Inter+Tight:wght@300;400;500;600&display=swap"
    />

    <!-- Sitemap & feed hints -->
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- JSON-LD structured data — alle entities samen -->
    <script type="application/ld+json" set:html={JSON.stringify(allJsonLd, null, 2)} />
  </head>
  <body>
    <a href="#main" class="skip-link">Spring naar de inhoud</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
