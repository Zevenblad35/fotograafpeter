---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, MAIN_MENU } from '../config';

const title = '404 — Pagina niet gevonden';
const description = 'De pagina die je zoekt bestaat niet (meer). Ga terug naar de homepage of bekijk de andere pagina\'s.';
---

<BaseLayout
  title={title}
  description={description}
  noindex={true}
>
  <section class="error-section">
    <div class="container error-inner">
      <span class="error-num">404</span>
      <h1>Deze pagina vinden we niet</h1>
      <p>
        Misschien is de pagina verhuisd, hernoemd, of bestaat hij niet meer.
        Ga terug naar de <a href="/" class="link-inline">homepagina</a>
        of probeer één van de pagina's hieronder.
      </p>

      <div class="error-actions">
        <a href="/" class="btn btn-primary">Naar home <span class="arrow">→</span></a>
        <a href="/contact/" class="btn btn-secondary">Neem contact op</a>
      </div>

      <ul class="error-links">
        {MAIN_MENU.filter(m => m.href !== '/').map(item => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .error-section {
    padding-block: clamp(4rem, 10vw, 8rem);
    min-height: 60vh;
    display: flex;
    align-items: center;
  }

  .error-inner {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .error-num {
    font-family: var(--font-display);
    font-size: clamp(5rem, 15vw, 9rem);
    font-weight: 250;
    line-height: 1;
    color: var(--color-accent);
    display: block;
    letter-spacing: -0.04em;
  }

  .error-inner h1 {
    font-size: clamp(1.75rem, 3vw + 1rem, 2.75rem);
    margin: 1.5rem 0;
  }

  .error-inner p {
    color: var(--color-ink-soft);
    margin: 0 auto 2.5rem;
    max-width: 50ch;
  }

  .error-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 3rem;
  }

  .error-links {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
    border-top: 1px solid var(--color-line);
    padding-top: 2rem;
  }

  .error-links a {
    font-size: 0.92rem;
    color: var(--color-ink-muted);
    transition: color var(--t);
    border-bottom: 1px solid transparent;
  }
  .error-links a:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
