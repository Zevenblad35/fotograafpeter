---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../config';

const title = 'Disclaimer | Fotograaf Peter';
const description = 'Disclaimer van Fotograaf Peter — voorwaarden voor gebruik van deze website.';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Disclaimer', href: '/disclaimer/' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/disclaimer/"
  breadcrumbs={breadcrumbs}
>
  <PageHeader
    eyebrow="Juridisch"
    title="Disclaimer"
    description="Voorwaarden voor gebruik van deze website. Laatst bijgewerkt op 1 januari 2026."
    breadcrumbs={breadcrumbs}
  />

  <article class="legal-section">
    <div class="container-prose legal-prose">
      <h2>Algemeen</h2>
      <p>
        De informatie op deze website is met de grootst mogelijke zorg samengesteld.
        Fotograaf Peter ({SITE.business.legalName}) kan echter niet aansprakelijk worden
        gesteld voor eventuele onjuistheden, onvolledigheden of de gevolgen van het
        gebruik van de informatie op deze website.
      </p>

      <h2>Auteursrecht</h2>
      <p>
        Alle foto's, teksten, vormgeving en andere content op deze website zijn
        eigendom van Fotograaf Peter en/of haar klanten (waar het foto's van opdrachten
        betreft). Niets van deze website mag worden gekopieerd, verveelvoudigd of
        gepubliceerd zonder schriftelijke toestemming.
      </p>

      <h2>Externe links</h2>
      <p>
        Deze website kan links bevatten naar websites van derden. Fotograaf Peter is
        niet verantwoordelijk voor de inhoud van die websites en het privacybeleid
        dat daar geldt.
      </p>

      <h2>Beschikbaarheid</h2>
      <p>
        Fotograaf Peter spant zich in om de website beschikbaar en up-to-date te
        houden, maar kan geen garantie geven op continue beschikbaarheid of
        foutloze werking.
      </p>

      <h2>Wijzigingen</h2>
      <p>
        Fotograaf Peter behoudt zich het recht voor om de inhoud van deze disclaimer
        en de website op elk moment aan te passen.
      </p>

      <h2>Contact</h2>
      <p>
        Vragen of opmerkingen?
        Mail naar <a href={`mailto:${SITE.contact.email}`} class="link-inline">{SITE.contact.email}</a>
        of bel {SITE.contact.phoneDisplay}.
      </p>
    </div>
  </article>
</BaseLayout>

<style>
  .legal-section { padding-block: clamp(2.5rem, 5vw, 4.5rem); }
  .legal-prose h2 {
    font-size: 1.4rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .legal-prose h2:first-child { margin-top: 0; }
  .legal-prose p {
    color: var(--color-ink-soft);
    margin-bottom: 1rem;
    line-height: 1.7;
  }
</style>
