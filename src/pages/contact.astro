---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE } from '../config';

const title = 'Contact | Fotograaf Peter — Nijverdal';
const description = 'Neem contact op met Fotograaf Peter in Nijverdal. Bel, mail of stuur een berichtje voor bedrijfsfotografie, personal branding, reclamefotografie of evenementenfotografie in Twente en Overijssel.';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Contact', href: '/contact/' },
];
---

<BaseLayout
  title={title}
  description={description}
  canonicalPath="/contact/"
  pageType="ContactPage"
  breadcrumbs={breadcrumbs}
>
  <PageHeader
    eyebrow="Contact"
    title="Laten we het hebben over jouw shoot"
    description="Bellen werkt het snelst. Mailen ook prima. Of vul het formulier in — ik reageer binnen één werkdag."
    breadcrumbs={breadcrumbs}
    image="/images/headers/contact.jpg"
    imageAlt="Fotograaf Peter contact — Nijverdal"
  />

  <section class="contact-section">
    <div class="container contact-grid">
      <!-- Directe gegevens -->
      <div class="contact-direct">
        <div class="contact-block">
          <span class="eyebrow">Direct</span>
          <h2>Bel of mail</h2>
          <ul class="contact-list">
            <li>
              <span class="contact-label">Telefoon</span>
              <a href={`tel:${SITE.contact.phone}`} class="contact-value">
                {SITE.contact.phoneDisplay}
              </a>
            </li>
            <li>
              <span class="contact-label">E-mail</span>
              <a href={`mailto:${SITE.contact.email}`} class="contact-value">
                {SITE.contact.email}
              </a>
            </li>
            <li>
              <span class="contact-label">Adres</span>
              <span class="contact-value">
                {SITE.contact.address.street}<br />
                {SITE.contact.address.postalCode} {SITE.contact.address.city}
              </span>
            </li>
          </ul>
        </div>

        <div class="contact-block">
          <span class="eyebrow">Bereikbaarheid</span>
          <h3>Openingstijden</h3>
          <ul class="hours">
            {SITE.openingHours.map(d => (
              <li class:list={[{ closed: !d.isOpen }]}>
                <span>{d.day}</span>
                <span>{d.hours}</span>
              </li>
            ))}
          </ul>
          <p class="hours-note">
            Buiten kantoortijden? Bel gerust voor spoed of plan een avondafspraak.
          </p>
        </div>

        <div class="contact-block business">
          <span class="eyebrow">Bedrijfsgegevens</span>
          <dl>
            <dt>Bedrijfsnaam</dt>
            <dd>{SITE.business.legalName}</dd>
            <dt>Eigenaar</dt>
            <dd>{SITE.business.owner}</dd>
            <dt>KvK</dt>
            <dd>{SITE.business.kvk}</dd>
            <dt>BTW</dt>
            <dd>{SITE.business.btw}</dd>
          </dl>
        </div>
      </div>

      <!-- Formulier -->
      <div class="contact-form-wrap">
        <span class="eyebrow">Of stuur een bericht</span>
        <h2>Vertel kort waar je aan denkt</h2>
        <p class="form-intro">
          Hoe meer je deelt, hoe scherper ik kan reageren. Toch geen idee wat je
          precies wilt? Geen probleem — bel dan even.
        </p>

        <form
          class="contact-form"
          method="post"
          data-form-key={SITE.formAccessKey}
          data-mail-to={SITE.contact.email}
          novalidate
        >
          <div class="form-row">
            <label for="naam">
              <span>Naam</span>
              <input type="text" id="naam" name="naam" required autocomplete="name" />
            </label>
            <label for="bedrijf">
              <span>Bedrijf <em>(optioneel)</em></span>
              <input type="text" id="bedrijf" name="bedrijf" autocomplete="organization" />
            </label>
          </div>

          <div class="form-row">
            <label for="email">
              <span>E-mail</span>
              <input type="email" id="email" name="email" required autocomplete="email" />
            </label>
            <label for="telefoon">
              <span>Telefoon <em>(optioneel)</em></span>
              <input type="tel" id="telefoon" name="telefoon" autocomplete="tel" />
            </label>
          </div>

          <label for="dienst">
            <span>Waar gaat het over?</span>
            <select id="dienst" name="dienst">
              <option value="">Kies een dienst…</option>
              <option value="bedrijfsfotografie">Bedrijfsfotografie</option>
              <option value="personal-branding">Personal Branding</option>
              <option value="reclamefotografie">Reclamefotografie</option>
              <option value="evenementenfotografie">Evenementenfotografie</option>
              <option value="anders">Iets anders / weet ik nog niet</option>
            </select>
          </label>

          <label for="bericht">
            <span>Je bericht</span>
            <textarea id="bericht" name="bericht" rows="5" required
              placeholder="Wat wil je laten fotograferen, voor welk doel, en wanneer ongeveer?"></textarea>
          </label>

          <button type="submit" class="btn btn-primary">
            <span class="btn-label">Verstuur bericht</span>
            <span class="arrow">→</span>
          </button>

          <p class="form-status" data-form-status role="status" aria-live="polite" hidden></p>

          <p class="form-note">
            Voorkeur voor een ander kanaal? Bel <a href={`tel:${SITE.contact.phone}`}>{SITE.contact.phoneDisplay}</a>
            of mail rechtstreeks naar <a href={`mailto:${SITE.contact.email}`}>{SITE.contact.email}</a>.
          </p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact-form');

  if (form) {
    const statusEl = form.querySelector<HTMLElement>('[data-form-status]')!;
    const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const btnLabel = submitBtn.querySelector<HTMLElement>('.btn-label')!;
    const accessKey = form.dataset.formKey || '';
    const mailTo = form.dataset.mailTo || '';

    function setStatus(msg: string, type: 'ok' | 'error') {
      statusEl.textContent = msg;
      statusEl.dataset.type = type;
      statusEl.hidden = false;
    }

    function getValues() {
      const fd = new FormData(form!);
      return {
        naam: String(fd.get('naam') || '').trim(),
        bedrijf: String(fd.get('bedrijf') || '').trim(),
        email: String(fd.get('email') || '').trim(),
        telefoon: String(fd.get('telefoon') || '').trim(),
        dienst: String(fd.get('dienst') || '').trim(),
        bericht: String(fd.get('bericht') || '').trim(),
      };
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      // Eigen validatie (novalidate op het form, dus hier checken)
      const v = getValues();
      if (!v.naam || !v.email || !v.bericht) {
        setStatus('Vul in ieder geval je naam, e-mailadres en bericht in.', 'error');
        return;
      }
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v.email)) {
        setStatus('Dat e-mailadres lijkt niet te kloppen — kijk er even naar.', 'error');
        return;
      }

      // Geen access key? Dan nette mailto-fallback met vooringevuld bericht.
      if (!accessKey) {
        const subject = encodeURIComponent(`Aanvraag via fotograafpeter.nl — ${v.dienst || 'algemeen'}`);
        const body = encodeURIComponent(
          `Naam: ${v.naam}\n` +
          (v.bedrijf ? `Bedrijf: ${v.bedrijf}\n` : '') +
          `E-mail: ${v.email}\n` +
          (v.telefoon ? `Telefoon: ${v.telefoon}\n` : '') +
          (v.dienst ? `Dienst: ${v.dienst}\n` : '') +
          `\n${v.bericht}`
        );
        window.location.href = `mailto:${mailTo}?subject=${subject}&body=${body}`;
        setStatus('Je e-mailprogramma opent nu met je bericht. Verstuur \'m daar — dan komt hij direct bij Peter aan.', 'ok');
        return;
      }

      // Versturen via Web3Forms
      submitBtn.disabled = true;
      btnLabel.textContent = 'Versturen…';

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify({
            access_key: accessKey,
            subject: `Aanvraag via fotograafpeter.nl — ${v.dienst || 'algemeen'}`,
            from_name: v.naam,
            naam: v.naam,
            bedrijf: v.bedrijf,
            email: v.email,
            telefoon: v.telefoon,
            dienst: v.dienst,
            bericht: v.bericht,
          }),
        });
        const data = await res.json();

        if (data.success) {
          form.reset();
          setStatus('Bedankt! Je bericht is verstuurd — ik reageer binnen één werkdag.', 'ok');
        } else {
          setStatus('Er ging iets mis bij het versturen. Probeer het nog eens, of mail direct naar ' + mailTo + '.', 'error');
        }
      } catch {
        setStatus('Er ging iets mis bij het versturen. Probeer het nog eens, of mail direct naar ' + mailTo + '.', 'error');
      } finally {
        submitBtn.disabled = false;
        btnLabel.textContent = 'Verstuur bericht';
      }
    });
  }
</script>

<style>
  .contact-section {
    padding-block: clamp(3rem, 6vw, 5rem);
  }

  .form-status {
    margin-top: 1rem;
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .form-status[data-type='ok'] {
    background: #e8f5ec;
    color: #1e7d3f;
    border: 1px solid #bfe3cb;
  }
  .form-status[data-type='error'] {
    background: #fbeaea;
    color: #b03434;
    border: 1px solid #f0c8c8;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: clamp(2.5rem, 5vw, 5rem);
  }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; }
  }

  /* Linkerkolom */
  .contact-direct {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .contact-block h2 { margin-top: 1rem; }
  .contact-block h3 { margin-top: 1rem; font-size: 1.5rem; }

  .contact-list {
    list-style: none;
    padding: 0;
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .contact-label {
    display: block;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-ink-muted);
    margin-bottom: 0.35rem;
  }

  .contact-value {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.3;
    color: var(--color-ink);
    transition: color var(--t);
  }
  a.contact-value:hover { color: var(--color-accent); }

  .hours {
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
  }
  .hours li {
    display: flex;
    justify-content: space-between;
    padding: 0.55rem 0;
    border-bottom: 1px dashed var(--color-line);
    font-size: 0.95rem;
  }
  .hours li.closed { color: var(--color-ink-muted); }

  .hours-note {
    margin-top: 1.25rem;
    font-size: 0.85rem;
    color: var(--color-ink-muted);
    font-style: italic;
  }

  .business dl {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem 1.25rem;
  }
  .business dt {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-ink-muted);
  }
  .business dd {
    font-size: 0.92rem;
    color: var(--color-ink);
    margin: 0;
  }

  /* Formulier */
  .contact-form-wrap h2 {
    margin-top: 1rem;
    margin-bottom: 1rem;
  }
  .form-intro {
    color: var(--color-ink-soft);
    margin-bottom: 2rem;
    max-width: 50ch;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  @media (max-width: 600px) {
    .form-row { grid-template-columns: 1fr; }
  }

  .contact-form label {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .contact-form span {
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-ink-soft);
    font-weight: 500;
  }
  .contact-form span em {
    color: var(--color-ink-muted);
    font-style: normal;
    font-weight: 400;
    text-transform: none;
    letter-spacing: 0;
  }

  .contact-form input,
  .contact-form select,
  .contact-form textarea {
    font-family: var(--font-body);
    font-size: 1rem;
    padding: 0.85rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    color: var(--color-ink);
    transition: border-color var(--t), background var(--t);
    width: 100%;
  }

  .contact-form input:focus,
  .contact-form select:focus,
  .contact-form textarea:focus {
    outline: none;
    border-color: var(--color-accent);
    background: white;
  }

  .contact-form textarea {
    resize: vertical;
    min-height: 120px;
    font-family: var(--font-body);
  }

  .contact-form .btn {
    margin-top: 0.75rem;
    align-self: flex-start;
  }

  .form-note {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--color-ink-muted);
  }
  .form-note a {
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-line);
  }
  .form-note a:hover { color: var(--color-accent); border-color: var(--color-accent); }
</style>
