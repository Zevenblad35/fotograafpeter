---
// FAQ component met automatische JSON-LD structured data.
// Cruciaal voor AI-tools (ChatGPT, Perplexity) en Google rich results.

export interface FaqItem {
  question: string;
  answer: string;
}

export interface Props {
  title?: string;
  eyebrow?: string;
  items: FaqItem[];
}

const { title = 'Veelgestelde vragen', eyebrow = 'FAQ', items } = Astro.props;

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<section class="faq-section">
  <div class="container">
    <div class="faq-grid">
      <div class="faq-head">
        <span class="eyebrow">{eyebrow}</span>
        <h2>{title}</h2>
      </div>

      <div class="faq-list">
        {items.map((item, i) => (
          <details class="faq-item" name="faq" open={i === 0}>
            <summary>
              <span class="faq-q">{item.question}</span>
              <span class="faq-icon" aria-hidden="true">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                  <path d="M8 3v10M3 8h10"/>
                </svg>
              </span>
            </summary>
            <div class="faq-a">
              <p set:html={item.answer}></p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqLd)} />

<style>
  .faq-section {
    padding-block: clamp(3rem, 7vw, 5.5rem);
    background: var(--color-bg-alt);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: clamp(2rem, 5vw, 5rem);
  }

  @media (max-width: 800px) {
    .faq-grid { grid-template-columns: 1fr; }
  }

  .faq-head {
    align-self: start;
  }

  .faq-head h2 {
    margin-top: 1rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .faq-item {
    border-top: 1px solid var(--color-line);
    padding-block: 1.25rem;
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 1vw + 0.85rem, 1.4rem);
    font-weight: 400;
    line-height: 1.3;
    color: var(--color-ink);
    transition: color var(--t);
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:hover { color: var(--color-accent); }

  .faq-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    flex-shrink: 0;
    transition: all var(--t);
    color: var(--color-ink-soft);
    margin-top: 4px;
  }
  .faq-item[open] .faq-icon {
    background: var(--color-ink);
    color: var(--color-bg);
    border-color: var(--color-ink);
    transform: rotate(135deg);
  }

  .faq-a {
    margin-top: 1rem;
    color: var(--color-ink-soft);
    font-size: 1rem;
    line-height: 1.7;
    animation: slideDown 0.4s ease-out;
  }
  .faq-a p { max-width: 65ch; }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>
