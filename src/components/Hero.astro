---
export interface Props {
  eyebrow?: string;
  title: string;
  titleEm?: string;
  description?: string;
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const { eyebrow, title, titleEm, description, primaryCta, secondaryCta } = Astro.props;
---

<section class="hero">
  <div class="container hero-inner">
    {eyebrow && <span class="eyebrow reveal">{eyebrow}</span>}

    <h1 class="hero-title reveal reveal-delay-1">
      {title}
      {titleEm && <><br /><em>{titleEm}</em></>}
    </h1>

    {description && <p class="hero-desc reveal reveal-delay-2">{description}</p>}

    {(primaryCta || secondaryCta) && (
      <div class="hero-ctas reveal reveal-delay-3">
        {primaryCta && (
          <a href={primaryCta.href} class="btn btn-primary">
            {primaryCta.label}
            <span class="arrow">→</span>
          </a>
        )}
        {secondaryCta && (
          <a href={secondaryCta.href} class="btn btn-secondary">{secondaryCta.label}</a>
        )}
      </div>
    )}

    <!-- Decoratieve cijfers/markers -->
    <div class="hero-mark reveal reveal-delay-4">
      <span class="hero-mark-num">№ 01</span>
      <span class="hero-mark-line"></span>
      <span class="hero-mark-text">Nijverdal · Twente · Overijssel</span>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(3rem, 8vw, 6rem) clamp(2.5rem, 6vw, 4.5rem);
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background:
      radial-gradient(circle at 20% 30%, rgba(139, 90, 43, 0.06) 0%, transparent 50%),
      radial-gradient(circle at 80% 70%, rgba(200, 155, 106, 0.05) 0%, transparent 50%);
    pointer-events: none;
  }

  .hero-inner {
    position: relative;
    max-width: 1100px;
  }

  .hero-title {
    margin-top: 1.25rem;
    font-size: clamp(2.75rem, 8vw + 0.5rem, 7rem);
    line-height: 0.98;
    font-weight: 250;
    letter-spacing: -0.04em;
    color: var(--color-ink);
    max-width: 14ch;
  }

  .hero-title em {
    font-style: italic;
    font-weight: 250;
    color: var(--color-accent);
    font-feature-settings: 'ss01' 1;
  }

  .hero-desc {
    margin-top: 1.75rem;
    max-width: 50ch;
    font-size: clamp(1.05rem, 1vw + 0.85rem, 1.25rem);
    color: var(--color-ink-soft);
    line-height: 1.55;
  }

  .hero-ctas {
    margin-top: 2.5rem;
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .hero-mark {
    margin-top: 3.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
    color: var(--color-ink-muted);
    font-size: 0.78rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }
  .hero-mark-num {
    font-family: var(--font-display);
    font-size: 0.85rem;
    color: var(--color-accent);
    letter-spacing: 0;
  }
  .hero-mark-line {
    flex: 1;
    max-width: 80px;
    height: 1px;
    background: var(--color-line);
  }
</style>
