---
export interface Service {
  title: string;
  description: string;
  href: string;
  number: string;
  tags?: string[];
  image?: string;
  imageAlt?: string;
}

export interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  services: Service[];
}

const { eyebrow, title, intro, services } = Astro.props;
---

<section class="services">
  <div class="container">
    <div class="services-head">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h2>{title}</h2>
      {intro && <p class="services-intro">{intro}</p>}
    </div>

    <div class="services-grid">
      {services.map((service) => (
        <a href={service.href} class="service-card">
          {service.image && (
            <div class="service-media">
              <img src={service.image} alt={service.imageAlt || ''} loading="lazy" />
            </div>
          )}
          <div class="service-body">
            <span class="service-num">{service.number}</span>
            <h3 class="service-title">{service.title}</h3>
            <p class="service-desc">{service.description}</p>
            {service.tags && (
              <ul class="service-tags">
                {service.tags.map(tag => <li>{tag}</li>)}
              </ul>
            )}
            <span class="service-cta">
              Bekijk dienst
              <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                <path d="M3 7h8M7.5 3.5L11 7l-3.5 3.5"/>
              </svg>
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    padding-block: clamp(3rem, 7vw, 6rem);
  }

  .services-head {
    margin-bottom: 3rem;
    max-width: 700px;
  }

  .services-head h2 {
    margin-top: 1rem;
  }

  .services-intro {
    margin-top: 1.25rem;
    color: var(--color-ink-soft);
    font-size: 1.1rem;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1.25rem;
  }

  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    transition: all var(--t);
    overflow: hidden;
  }

  .service-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-accent);
    box-shadow: 0 20px 40px -20px rgba(26, 24, 20, 0.18);
  }

  .service-media {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-bg-alt);
  }
  .service-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .service-card:hover .service-media img {
    transform: scale(1.04);
  }

  .service-body {
    padding: 1.75rem 1.75rem 1.75rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .service-num {
    font-family: var(--font-display);
    font-size: 0.85rem;
    color: var(--color-accent);
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .service-title {
    font-size: 1.4rem;
    margin-bottom: 0.75rem;
    line-height: 1.15;
  }

  .service-desc {
    color: var(--color-ink-soft);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }

  .service-tags {
    list-style: none;
    padding: 0;
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 1.25rem;
  }
  .service-tags li {
    font-size: 0.72rem;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--color-line);
    border-radius: 999px;
    color: var(--color-ink-muted);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .service-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    color: var(--color-ink);
    font-weight: 500;
    transition: gap var(--t);
  }
  .service-card:hover .service-cta { gap: 0.65rem; color: var(--color-accent); }
</style>
