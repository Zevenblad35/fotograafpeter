---
export interface Crumb { name: string; href: string; }

export interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  breadcrumbs?: Crumb[];
}

const { eyebrow, title, description, breadcrumbs } = Astro.props;
---

<section class="page-header">
  <div class="container">
    {breadcrumbs && breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="breadcrumb">
        <ol>
          {breadcrumbs.map((b, i) => (
            <li>
              {i < breadcrumbs.length - 1
                ? <><a href={b.href}>{b.name}</a><span class="sep">/</span></>
                : <span aria-current="page">{b.name}</span>
              }
            </li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <span class="eyebrow reveal">{eyebrow}</span>}
    <h1 class="page-title reveal reveal-delay-1">{title}</h1>
    {description && <p class="page-desc reveal reveal-delay-2">{description}</p>}
  </div>
</section>

<style>
  .page-header {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(2rem, 4vw, 3rem);
    border-bottom: 1px solid var(--color-line);
  }

  .breadcrumb ol {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    font-size: 0.82rem;
    color: var(--color-ink-muted);
    margin-bottom: 1.75rem;
    letter-spacing: 0.02em;
  }
  .breadcrumb a {
    color: var(--color-ink-muted);
    transition: color var(--t);
  }
  .breadcrumb a:hover { color: var(--color-accent); }
  .breadcrumb .sep { margin-left: 0.6rem; opacity: 0.5; }
  .breadcrumb [aria-current] { color: var(--color-ink); }

  .page-title {
    margin-top: 1rem;
    font-size: clamp(2.5rem, 6vw + 0.5rem, 5rem);
    line-height: 1;
    font-weight: 250;
    max-width: 18ch;
    letter-spacing: -0.035em;
  }

  .page-desc {
    margin-top: 1.5rem;
    max-width: 60ch;
    font-size: clamp(1.05rem, 1vw + 0.85rem, 1.2rem);
    color: var(--color-ink-soft);
    line-height: 1.55;
  }
</style>
